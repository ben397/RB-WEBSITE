# The site's real deployed URL — used for metadataBase, OG images, robots.txt, and
# sitemap.xml. Falls back to http://localhost:3000 if unset, which is wrong for
# production (share cards and canonical URLs will point at localhost).
NEXT_PUBLIC_SITE_URL=

# Contact form (app/api/contact/route.ts) — sends via Resend's HTTP API.
# Without RESEND_API_KEY set, the form fails gracefully with a clear "not configured"
# message instead of pretending to send.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Donate (app/api/donate/route.ts) — M-Pesa STK push via PayHero's API.
# Without these set, the donate form fails gracefully with a clear "not configured"
# message instead of pretending to send an STK push. Field names/auth scheme haven't
# been verified against a live PayHero key — check docs.payhero.co.ke before relying
# on this in production.
PAYHERO_API_KEY=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=
