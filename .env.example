# The site's real deployed URL — used for metadataBase, OG images, robots.txt, and
# sitemap.xml. Falls back to http://localhost:3000 if unset, which is wrong for
# production (share cards and canonical URLs will point at localhost).
NEXT_PUBLIC_SITE_URL=

# Contact form (app/api/contact/route.ts) — sends via Resend's HTTP API.
# Without RESEND_API_KEY set, the form fails gracefully with a clear "not configured"
# message instead of pretending to send.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Donate (app/api/donate/route.ts) — M-Pesa STK push via PayHero's "Initiate MPESA STK
# Push" API (backend.payhero.co.ke/api/v2/payments), matched against PayHero's own docs.
# Without credentials + PAYHERO_CHANNEL_ID set, the donate form fails gracefully with a
# clear "not configured" message instead of pretending to send an STK push.
#
# PayHero doesn't issue a single opaque "API key" — its dashboard gives you an API
# Username + API Password (standard HTTP Basic auth) and, separately, an already-encoded
# "Basic auth token" as a convenience. Use ONE of the two options below, not both:
#
# Option A — paste the pre-built token from the dashboard as-is:
PAYHERO_BASIC_AUTH_TOKEN=
# Option B — give the username/password pair and let the code base64-encode it:
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
#
# Your Payment Channel ID — PayHero dashboard → Payment Channels → My Payment Channels.
# (PayHero's dashboard also shows an "Account ID"; that's account-level, not something
# this STK push endpoint's request body takes, so it isn't used here.)
PAYHERO_CHANNEL_ID=
# Where PayHero POSTs the final payment result (see app/api/donate/callback/route.ts).
# Must be a publicly reachable URL, e.g. https://<your-domain>/api/donate/callback.
PAYHERO_CALLBACK_URL=
# Optional — only needed if you're using your own Mpesa Daraja credentials via PayHero
# rather than PayHero's shared/default ones.
PAYHERO_CREDENTIAL_ID=
